  SELECT row_to_json(r) FROM retrieval_evaluations r WHERE id = 35   -> vector-snapshot-35.json
  Rank diff (results->'questions' of both rows joined on question id):
    WITH q35 AS (SELECT e->>'id' id, e->>'rank' rank, e->>'matchedChunkId' chunk FROM retrieval_evaluations, jsonb_array_elements(results->'questions') e WHERE id=35),
         q34 AS (SELECT e->>'id' id, e->>'rank' rank, e->>'matchedChunkId' chunk FROM retrieval_evaluations, jsonb_array_elements(results->'questions') e WHERE id=34)
    SELECT q35.id, coalesce(q35.rank,'miss'), coalesce(q34.rank,'miss'), q35.chunk, q34.chunk FROM q35 JOIN q34 USING (id) WHERE coalesce(q35.rank,'') <> coalesce(q34.rank,'') ORDER BY 1

