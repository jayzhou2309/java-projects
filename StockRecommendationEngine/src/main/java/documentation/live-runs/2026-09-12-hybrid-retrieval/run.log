Queries (docker exec -i trading-postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tA -c "..."):
  SELECT id, evaluated_at, retrieval_strategy, hit_at_1, hit_at_3, hit_at_5, mrr, properties FROM retrieval_evaluations WHERE id IN (34, 35) ORDER BY id
  SELECT id, set_version, question_count, window_size, jsonb_typeof(results) FROM retrieval_evaluations WHERE id IN (34,35)      -> v1 | 30 | 10 for both
  SELECT id, results->'tickerHitAt5', jsonb_array_length(results->'misses') FROM retrieval_evaluations WHERE id IN (34,35)
