  Finding 1, script. Source (scratchpad hits.py, run from the project root):
    # Lists every RAG.md line outside generated blocks that mentions a measurement term (Milestone 4b remediation 2, finding 1).
    import re, sys
    path = sys.argv[1] if len(sys.argv) > 1 else 'src/main/java/documentation/RAG.md'
    marker = re.compile(r'^[ \t]*<!-- generated:\S+ (start|end) -->[ \t]*$')
    ids = list(range(247, 251)) + list(range(295, 300)) + list(range(598, 642))
    terms = [
        ('hit@1', re.compile(r'hit@1', re.I)), ('hit@3', re.compile(r'hit@3|hit@1/3', re.I)), ('hit@5', re.compile(r'hit@5|hit@1/3/5', re.I)),
        ('MRR', re.compile(r'\bMRR\b', re.I)),
        ('snapshot id', re.compile(r'(?<![\d.,])(?:' + '|'.join(map(str, ids)) + r')(?![\d]|,\d{3})')),
        ('qualif', re.compile(r'qualif', re.I)), ('figure slice', re.compile(r'figure slice', re.I)),
        ('non-figure', re.compile(r'non-figure', re.I)), ('NVDA 8', re.compile(r'NVDA 8')), ('NVDA 9', re.compile(r'NVDA 9')),
        ('question id', re.compile(r'\b(?:aapl|msft|nvda)-\d{2}\b', re.I)),
    ]
    inside = False
    count = 0
    for n, line in enumerate(open(path, encoding='utf-8').read().split('\n'), 1):
        m = marker.match(line)
        if m:
            inside = m.group(1) == 'start'
            continue
        if inside:
            continue
        found = []
        for name, rx in terms:
            hits = sorted(set(x.group(0) for x in rx.finditer(line)))
            if hits:
                found.append(name + (' ' + ','.join(hits) if name in ('snapshot id', 'question id') else ''))
        if found:
            count += 1
            print(f'{n}: [{"; ".join(found)}] {line.strip()[:60]}')
    print(f'lines with hits: {count}')
