{
  "description": "Claims check fixture (ClaimsCheckTests): one or more true claims per check type and basis; every claim passes.",
  "claims": [
    {"id": "C-001", "text": "The reference row ranks aapl-01 first.", "basis": "observed", "block": "ranks",
     "check": {"type": "rank", "snapshot": "snapshots/reference.json", "question": "aapl-01", "expected": 1}},
    {"id": "C-002", "text": "Row A has no chunk matching msft-04 in its window.", "basis": "observed", "block": "ranks",
     "check": {"type": "rank", "snapshot": "snapshots/row-a.json", "question": "msft-04", "expected": null}},
    {"id": "C-003", "text": "msft-04 is inside the top 5 in the reference row and row C, and outside it in rows A and B.", "basis": "derived",
     "check": {"type": "topK", "question": "msft-04", "k": 5, "rows": [
       {"snapshot": "snapshots/reference.json", "expected": "inside"}, {"snapshot": "snapshots/row-a.json", "expected": "outside"},
       {"snapshot": "snapshots/row-b.json", "expected": "outside"}, {"snapshot": "snapshots/row-c.json", "expected": "inside"}]}},
    {"id": "C-004", "text": "The reference row's hit@5 is 0.750000.", "basis": "observed",
     "check": {"type": "metric", "snapshot": "snapshots/reference.json", "metric": "hitAt5", "expected": "0.750000"}},
    {"id": "C-005", "text": "Row C's figure-slice hit@5 is 0.666667.", "basis": "observed",
     "check": {"type": "metric", "snapshot": "snapshots/row-c.json", "metric": "slices.figure.hitAt5", "expected": 0.666667}},
    {"id": "C-006", "text": "Row B's NVDA hit@5 is 0.500000.", "basis": "observed",
     "check": {"type": "metric", "snapshot": "snapshots/row-b.json", "metric": "tickerHitAt5.NVDA", "expected": "0.5"}},
    {"id": "C-007", "text": "Against the reference, row C keeps aggregate, non-figure, and every ticker's hit@5 but drops a FIGURE question from the top 5.", "basis": "derived",
     "check": {"type": "ruleRow", "reference": "snapshots/reference.json", "candidate": "snapshots/row-c.json",
       "criteria": {"aggregateHitAt5": "pass", "nonFigureHitAt5": "pass", "tickerHitAt5": "pass", "figureKindTop5": "fail"}}},
    {"id": "C-008", "text": "q1's phrase occupies tokens [12, 16) and characters [60, 79) of chunk 101.", "basis": "derived",
     "check": {"type": "phraseSpan", "report": "../evidence/scripted-report.json", "question": "q1", "phrase": "w012 w013 w014 w015", "chunk": 101,
       "expected": {"tokenSpan": [12, 16], "characterSpan": [60, 79]}}},
    {"id": "C-009", "text": "The head cut splits that occurrence and no row of the recorded scoring holds it wholly.", "basis": "derived",
     "check": {"type": "membership", "report": "../evidence/scripted-report.json", "question": "q1", "phrase": "w012 w013 w014 w015", "chunk": 101,
       "occurrence": 1, "expected": {"head": "partly", "windowsHoldingWholly": []}}},
    {"id": "C-010", "text": "In the traced report chunk 101 was a rerank input at fused position 1, reranked 3.", "basis": "observed",
     "check": {"type": "candidate", "report": "../evidence/scripted-report.json", "question": "q1", "chunk": 101,
       "expected": {"fusedPosition": 1, "rerankInput": true, "rerankedPosition": 3}}},
    {"id": "C-011", "text": "q2 fell back, chunk 201 is not in its fused list, and by the fused position it was not a rerank input.", "basis": "derived",
     "check": {"type": "candidate", "report": "../evidence/scripted-report.json", "question": "q2", "chunk": 201,
       "expected": {"fusedPosition": null, "rerankInput": false}}},
    {"id": "C-012", "text": "The untraced report does not record whether chunk 101 was a rerank input for q1.", "basis": "unknown",
     "check": {"type": "notRecorded", "report": "../evidence/scripted-report-untraced.json", "path": "questions[id=q1].phrases[0].chunks[chunkId=101].rerankInput", "reason": "no trace"}},
    {"id": "C-013", "text": "The traced report does not record q3's rerank outcome.", "basis": "unknown",
     "check": {"type": "notRecorded", "report": "../evidence/scripted-report.json", "path": "questions[id=q3].rerankOutcome"}},
    {"id": "C-014", "text": "msft-04 left the top 5 in rows A and B although q1's chunk 101 was still reranked in the traced report.", "basis": "inferred",
     "from": ["C-003", "C-010"]},
    {"id": "C-015", "text": "Raising the window overlap from 64 to 224 lifted msft-04 from rank 8 into the top 5.", "basis": "experiment",
     "experiment": {"file": "experiments/overlap-64-224.json", "factor": "rag.retrieval.cross-encoder.window-overlap-tokens"},
     "check": {"type": "topK", "question": "msft-04", "k": 5, "rows": [
       {"snapshot": "snapshots/row-b.json", "expected": "outside"}, {"snapshot": "snapshots/row-c.json", "expected": "inside"}]}}
  ]
}
